{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "check-computer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "check_computer_db",
      "database_name": "check-computer-db",
      "database_id": "713464f3-c791-4346-947d-12f102006763"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "check-computer-media"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_NAME": "Check Computer"
  }
}
